{
	"name": "praxity-trace",
	"version": "0.1.1",
	"private": true,
	"license": "MIT",
	"type": "module",
	"description": "Design diagnostics for learning courses",
	"bin": {
		"praxity-trace": "lib/cli.js"
	},
	"scripts": {
		"package": "node scripts/package.mjs",
		"typecheck": "tsc --noEmit",
		"test": "node --test test/*.test.ts",
		"verify": "pnpm lint && pnpm typecheck && pnpm test",
		"lint": "node scripts/check-comments.mjs",
		"prepack": "node scripts/package.mjs --npm",
		"test:npm": "node scripts/verify-npm-smoke.mjs"
	},
	"engines": {
		"node": ">=24.22.1 <25"
	},
	"packageManager": "pnpm@11.5.3",
	"devDependencies": {
		"@axe-core/playwright": "^4.12.1",
		"@types/node": "^24.13.6",
		"playwright": "^1.62.1",
		"typescript": "^7.0.2",
		"typescript-api": "npm:typescript@6.0.3"
	},
	"dependencies": {
		"parse5": "8.0.1"
	},
	"files": [
		"lib/",
		"data/bloom-verbs.json",
		"data/tubelex-en.tsv.gz",
		"skill/",
		"docs/task-coding-guide.md",
		"README.md",
		"LICENSE",
		"LICENSING.md",
		"NOTICE.md"
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/Praxity/praxity-trace"
	}
}
