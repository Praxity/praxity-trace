{"ok":true,"schema":"praxity-inspect/0","studioVersion":"0.2.0","course":{"id":"examples","title":"Examples","locale":"en","description":null},"lessons":[{"file":"minimal.prax","id":null,"title":"Workspace Safety Starter","sha256":"c677f1cd110105f7ce79105df902253764f87b8426248484c11c9fb04466deb2","frontmatter":{"title":"Workspace Safety Starter","lang":"en","design":{"palette":"standard","colorMode":"light","accentHue":220},"firstPage":{"id":"page-e3d4df5b-e14a-49d2-b278-416cfb0818a2"}},"pages":[{"id":"page-e3d4df5b-e14a-49d2-b278-416cfb0818a2","number":1,"title":"Welcome","data":{"id":"page-e3d4df5b-e14a-49d2-b278-416cfb0818a2"},"blocks":[{"id":"heading-0","type":"heading","line":10,"data":{"level":2,"content":"<p>Welcome</p>"}},{"id":"text-1","type":"text","line":12,"data":{"content":"<p>This short course introduces a simple safety routine you can run before starting work.</p>"}},{"id":"image-2","type":"image","line":14,"data":{"src":"/assets/safety-checklist.png","alt":"Checklist on a clipboard","caption":"Daily pre-shift checklist"}}]},{"id":"page-caa252b9-27b4-49e4-89da-c2581284238f","number":2,"title":"Before You Begin","data":{"id":"page-caa252b9-27b4-49e4-89da-c2581284238f"},"blocks":[{"id":"heading-4","type":"heading","line":20,"data":{"level":2,"content":"<p>Before You Begin</p>"}},{"id":"text-5","type":"text","line":22,"data":{"content":"<p>Confirm emergency exits are clear and protective gear is available.</p>"}}]}]},{"file":"interactive-module.prax","id":null,"title":"Interactive Safety Walkthrough","sha256":"8c44b7dcb3f3356f26b1b5407372b8f90b4a59ec2c7a1f9b2f226211d93cc6bd","frontmatter":{"title":"Interactive Safety Walkthrough","lang":"en","design":{"palette":"campfire","colorMode":"light","accentHue":24},"firstPage":{"id":"page-19c7f62a-9dcb-40e2-a90d-1acb6dc760c1"}},"pages":[{"id":"page-19c7f62a-9dcb-40e2-a90d-1acb6dc760c1","number":1,"title":"Welcome","data":{"id":"page-19c7f62a-9dcb-40e2-a90d-1acb6dc760c1"},"blocks":[{"id":"heading-0","type":"headi